# Redis Configuration for Celery
# Copy to .env and update with your Railway values
# Railway automatically sets REDIS_URL, but you can override if needed

# Railway Redis Configuration (auto-configured)
# REDIS_URL is automatically set by Railway
# REDIS_URL=redis://redis:6379/0 (file processing DB)
# REDIS_URL_WEB=redis://redis:6379/1 (web crawling DB)

# Database Configuration
# Railway automatically sets DATABASE_URL, but you can override if needed
DATABASE_URL=postgresql://user:password@localhost:5432/knowledgebot

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Worker Configuration
# File processing worker concurrency (2-4 recommended)
FILE_WORKER_CONCURRENCY=2

# Web crawling worker concurrency (1-2 recommended, crawling is heavy)
WEB_WORKER_CONCURRENCY=1

# Task Timeouts (in seconds)
FILE_TASK_SOFT_TIME_LIMIT=1800      # 30 minutes
FILE_TASK_HARD_TIME_LIMIT=1900      # 31+ minutes

WEB_TASK_SOFT_TIME_LIMIT=7200       # 2 hours
WEB_TASK_HARD_TIME_LIMIT=7300       # 2+ hours

# Logging
LOG_LEVEL=INFO
CELERY_LOG_LEVEL=info

# Environment
ENVIRONMENT=production
PYTHONUNBUFFERED=1
