# Dockerfile for Celery Workers
# Build image: docker build -f Dockerfile.celery -t knowledgebot-celery-worker .
# Run file processing worker: docker run -e REDIS_URL=redis://redis:6379/0 knowledgebot-celery-worker celery -A knowledgebase_ingestion.celery_app worker -Q file_processing -l info
# Run web crawling worker: docker run -e REDIS_URL=redis://redis:6379/1 knowledgebot-celery-worker celery -A website_crawling.celery_app worker -Q web_crawling -l info

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    postgresql-client \
    chromium \
    chromium-driver \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements files
COPY knowledgebase_ingestion/requirements.txt /tmp/kb-requirements.txt
COPY website_crawling/requirements.txt /tmp/web-requirements.txt

# Try to copy shared requirements if it exists
COPY shared/requirements.txt /tmp/shared-requirements.txt || true

# Install Python dependencies
RUN pip install --no-cache-dir -r /tmp/kb-requirements.txt && \
    pip install --no-cache-dir -r /tmp/web-requirements.txt && \
    (pip install --no-cache-dir -r /tmp/shared-requirements.txt || true)

# Copy application code
COPY . .

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV CELERY_BROKER_URL=${REDIS_URL:-redis://localhost:6379/0}
ENV CELERY_RESULT_BACKEND=${REDIS_URL:-redis://localhost:6379/0}

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5555/api/workers || exit 1

# Default command - override with specific celery command
CMD ["celery", "-A", "knowledgebase_ingestion.celery_app", "worker", "-l", "info"]
